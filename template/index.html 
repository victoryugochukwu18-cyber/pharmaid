<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PharmaTech Solutions</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: #0d1117;
      color: #e6edf3;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Top Navigation Bar */
    .navbar {
      display: flex;
      align-items: center;
      padding: 12px 16px;
      background-color: #0d1117;
      border-bottom: 1px solid #21262d;
      gap: 12px;
    }

    .menu-btn {
      background: transparent;
      border: 1px solid #30363d;
      border-radius: 6px;
      color: #e6edf3;
      padding: 8px 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .nav-title {
      color: #38bdf8;
      font-size: 1.1rem;
      font-weight: 600;
    }

    /* Main Container */
    .main-container {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px 16px;
    }

    /* Form Card */
    .card {
      background-color: #161b22;
      border: 1px solid #21262d;
      border-radius: 12px;
      padding: 24px;
      width: 100%;
      max-width: 420px;
    }

    .card-title {
      color: #38bdf8;
      font-size: 1.8rem;
      font-weight: 700;
      text-align: center;
      margin-bottom: 8px;
    }

    .card-subtitle {
      color: #9198a1;
      font-size: 0.95rem;
      text-align: center;
      margin-bottom: 24px;
    }

    /* Tab Controls */
    .tabs {
      display: flex;
      gap: 12px;
      margin-bottom: 20px;
    }

    .tab-btn {
      flex: 1;
      padding: 10px;
      border-radius: 6px;
      font-size: 0.95rem;
      cursor: pointer;
      text-align: center;
    }

    .tab-btn.active {
      background-color: #30363d;
      color: #38bdf8;
      border: 1px solid #38bdf8;
      font-weight: 600;
    }

    .tab-btn.inactive {
      background-color: transparent;
      color: #8b949e;
      border: 1px solid #30363d;
    }

    /* Form Elements */
    .form-group {
      margin-bottom: 16px;
    }

    label {
      display: block;
      color: #8b949e;
      font-size: 0.9rem;
      margin-bottom: 6px;
    }

    input[type="email"],
    input[type="password"] {
      width: 100%;
      padding: 10px 12px;
      background-color: #21262d;
      border: 1px solid #30363d;
      border-radius: 6px;
      color: #e6edf3;
      font-size: 0.95rem;
      outline: none;
    }

    input[type="email"]:focus,
    input[type="password"]:focus {
      border-color: #38bdf8;
    }

    .checkbox-group {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 20px;
    }

    .checkbox-group input[type="checkbox"] {
      width: 16px;
      height: 16px;
      accent-color: #0284c7;
      cursor: pointer;
    }

    .checkbox-group label {
      margin-bottom: 0;
      color: #8b949e;
      font-size: 0.85rem;
      cursor: pointer;
    }

    .submit-btn {
      width: 100%;
      padding: 12px;
      background-color: #0284c7;
      color: #ffffff;
      border: none;
      border-radius: 6px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      margin-bottom: 20px;
    }

    .submit-btn:hover {
      background-color: #0369a1;
    }

    .form-footer {
      color: #8b949e;
      font-size: 0.85rem;
      line-height: 1.4;
    }
  </style>
</head>
<body>

  <!-- Navbar Header -->
  <header class="navbar">
    <button class="menu-btn" aria-label="Toggle Menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <div class="nav-title">PharmaTech Solutions</div>
  </header>

  <!-- Main Content Box -->
  <main class="main-container">
    <div class="card">
      <h1 class="card-title">PharmaTech Solutions</h1>
      <p class="card-subtitle">Your Pharmaceutical Technology Platform</p>

      <!-- Toggle Tabs -->
      <div class="tabs">
        <button class="tab-btn active">Sign in</button>
        <button class="tab-btn inactive">Create account</button>
      </div>

      <!-- Sign-In Form -->
      <form onsubmit="event.preventDefault();">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" required>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" required>
        </div>

        <div class="checkbox-group">
          <input type="checkbox" id="keep-signed-in">
          <label for="keep-signed-in">Keep me signed in on this device</label>
        </div>

        <button type="submit" class="submit-btn">Sign in</button>
      </form>

      <p class="form-footer">
        New here? Choose Create account. There is no email password reset yet, so keep your password safe.
      </p>
    </div>
  </main>

</body>
</html>
